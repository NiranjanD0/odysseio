# Application Settings
ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=0.0.0.0
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database (PostgreSQL)
# For local dev without Docker, can fall back to sqlite+aiosqlite:///./odysseio.db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/odysseio
# SQLITE_FALLBACK=true allows graceful fallback to local sqlite for testing/dev if Postgres is unavailable
DATABASE_SQLITE_FALLBACK=true

# External APIs
# Geoapify (https://www.geoapify.com/)
GEOAPIFY_API_KEY=

# Routing Provider: "geoapify" or "mock" or "osrm"
ROUTING_PROVIDER=geoapify
ROUTING_TIMEOUT_SECONDS=10.0

# Open-Meteo (No API key needed for basic tiers)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
AIR_QUALITY_BASE_URL=https://air-quality-api.open-meteo.com/v1

# CityBikes (No API key needed)
CITYBIKES_BASE_URL=https://api.citybik.es/v2

# Telegram Bot (Optional notifications)
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=

# Itinerary Default Settings
DEFAULT_SAFETY_BUFFER_MINUTES=15
MAX_SEARCH_RADIUS_METERS=5000
